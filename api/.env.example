PORT=3000

# memoria  -> datos de ejemplo en memoria (desarrollo / pruebas, no persiste)
# firebase -> Firestore + Firebase Auth mediante firebase-admin (producción)
MODO_DATOS=memoria

# Solo con MODO_DATOS=firebase
# Ruta al JSON de la cuenta de servicio (o usa GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
# "Web API key" del proyecto Firebase (para validar correo/contraseña en el login)
FIREBASE_WEB_API_KEY=

# Correos (separados por coma) que obtienen el rol administrador automáticamente
ADMIN_EMAILS=

# Zona horaria del negocio como desfase respecto a UTC (Colombia = -5, sin horario de verano)
UTC_OFFSET_HORAS=-5

# Solo modo memoria: secreto para firmar tokens
JWT_SECRET=cambia-esto-en-desarrollo
